# Optional OpenAI-compatible server provider. The browser-local model does not require this server.
# Server only: never place the key in VITE_* variables, browser code, or a committed .env file.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
HOST=127.0.0.1
PORT=8787
# Exact origins only, comma separated. Add a deployed frontend origin only when using this provider.
CODEGROW_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
