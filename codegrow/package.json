{
  "name": "codegrow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An open-source programming mentor for C learners.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:server": "node --test server/*.test.mjs",
    "test:e2e": "node tests/web.e2e.mjs",
    "test:database": "node tests/database.browser.mjs",
    "prepare:compiler": "node scripts/prepare-compiler.mjs",
    "build:site": "npm run prepare:compiler && npm run build",
    "ai:server": "node --env-file-if-exists=server/.env server/index.mjs",
    "postinstall": "node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.85",
    "@monaco-editor/react": "4.7.0",
    "@runno/wasi": "0.10.0",
    "lucide-react": "1.55.0",
    "monaco-editor": "0.55.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sql.js": "1.14.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "playwright": "1.62.1"
  }
}
